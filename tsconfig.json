{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "outDir": "dist-electron",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    },
    "types": ["node"]
  },
  "include": ["src/main", "src/preload", "src/shared"],
  "exclude": ["node_modules", "dist-electron"]
}
